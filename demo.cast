{"version": 2, "width": 100, "height": 34, "timestamp": 1794165228, "title": "Primitive DB demo", "env": {"SHELL": "powershell.exe", "TERM": "xterm-256color"}}
[0.4, "o", "$ uv run database\r\n"]
[0.6, "o", "\r\n***\r\n<command> exit - выйти из программы\r\n<command> help - справочная информация\r\n"]
[1.0, "o", "Введите команду: "]
[1.3, "o", "help\r\n"]
[1.5, "o", "***База данных***\r\n\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу со всеми записями\r\n\r\n***Операции с данными***\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись\r\n<command> select from <имя_таблицы> [where <столбец> = <значение>] - прочитать записи\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение> where <столбец_условия> = <значение_условия> - обновить запись\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись\r\n<command> info <имя_таблицы> - вывести информацию о таблице\r\n<command> exit - выйти из программы\r\n<command> help - справочная информация\r\n"]
[1.9, "o", "Введите команду: "]
[2.2, "o", "create_table users name:str age:int is_active:bool\r\n"]
[2.4, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[2.8, "o", "Введите команду: "]
[3.1, "o", "list_tables\r\n"]
[3.3, "o", "- users\r\n"]
[3.7, "o", "Введите команду: "]
[4.0, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[4.2, "o", "Функция insert выполнилась за 0.000 секунд.\r\nЗапись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[4.6, "o", "Введите команду: "]
[4.9, "o", "insert into users values (\"Anna\", 34, false)\r\n"]
[5.1, "o", "Функция insert выполнилась за 0.000 секунд.\r\nЗапись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[5.5, "o", "Введите команду: "]
[5.8, "o", "select from users\r\n"]
[6.0, "o", "Функция select выполнилась за 0.000 секунд.\r\n+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  34 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[6.4, "o", "Введите команду: "]
[6.7, "o", "select from users where age = 28\r\n"]
[6.9, "o", "Функция select выполнилась за 0.000 секунд.\r\n+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[7.3, "o", "Введите команду: "]
[7.6, "o", "update users set age = 29 where name = \"Sergei\"\r\n"]
[7.8, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[8.2, "o", "Введите команду: "]
[8.5, "o", "select from users\r\n"]
[8.7, "o", "Функция select выполнилась за 0.000 секунд.\r\n+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n| 2  |  Anna  |  34 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[9.1, "o", "Введите команду: "]
[9.4, "o", "delete from users where ID = 2\r\n"]
[9.8, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[10.1, "o", "y\r\n"]
[10.3, "o", "Запись с ID=2 успешно удалена из таблицы \"users\".\r\n"]
[10.7, "o", "Введите команду: "]
[11.0, "o", "select from users\r\n"]
[11.2, "o", "Функция select выполнилась за 0.000 секунд.\r\n+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[11.6, "o", "Введите команду: "]
[11.9, "o", "info users\r\n"]
[12.1, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 1\r\n"]
[12.5, "o", "Введите команду: "]
[12.8, "o", "drop_table users\r\n"]
[13.2, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[13.5, "o", "y\r\n"]
[13.7, "o", "Таблица \"users\" успешно удалена.\r\n"]
[14.1, "o", "Введите команду: "]
[14.4, "o", "exit\r\n"]
